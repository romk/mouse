{
  "redirects": [
    {
      "source": "/square",
      "destination": "/square/",
      "permanent": true
    },
    {
      "source": "/mouse",
      "destination": "/mouse/",
      "permanent": true
    },
    {
      "source": "/pi",
      "destination": "/pi/",
      "permanent": true
    },
    {
      "source": "/e",
      "destination": "/e/",
      "permanent": true
    },
    {
      "source": "/puzzle",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|_vercel/).*)",
      "has": [
        {
          "type": "host",
          "value": "mouse.romke.com"
        }
      ],
      "destination": "/mouse/:path"
    },
    {
      "source": "/",
      "destination": "/puzzle/"
    },
    {
      "source": "/stats",
      "destination": "/puzzle/stats.html"
    }
  ]
}
